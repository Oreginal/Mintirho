---
import { Image } from 'astro:assets';
import logo from '../assets/brand/mintirho-logo.png';
import Icon from './Icon.astro';
import { primaryNav, isActive } from '../data/navigation';
import { site, whatsappUrl } from '../data/site';

const path = Astro.url.pathname;
const normalise = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const current = normalise(path);
---

<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu" data-menu>
  <div class="mobile-menu__inner">
    <div class="mobile-menu__top">
      <a href="/" class="mobile-menu__brand">
        <Image
          src={logo}
          alt={`${site.name} home`}
          width={105}
          height={44}
          densities={[2, 3]}
          format="webp"
          quality={90}
        />
      </a>
      <button type="button" class="mobile-menu__close" data-menu-close>
        <Icon name="close" size={24} />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

    <nav aria-label="Main">
      <ul role="list" class="mobile-menu__list">
        {primaryNav.map((item, index) =>
          item.children ? (
            <li>
              <button
                type="button"
                class:list={['mobile-menu__link', { 'is-active': isActive(item, path) }]}
                aria-expanded={isActive(item, path) ? 'true' : 'false'}
                aria-controls={`mobile-panel-${index}`}
                data-accordion-trigger
              >
                {item.label}
                <Icon name="chevron-down" size={20} class="mobile-menu__chevron" />
              </button>
              <ul
                id={`mobile-panel-${index}`}
                class="mobile-menu__sub"
                role="list"
                hidden={!isActive(item, path)}
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={normalise(child.href) === current ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
                {item.overview && (
                  <li>
                    <a href={item.overview.href} class="mobile-menu__overview">
                      {item.overview.label}
                    </a>
                  </li>
                )}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={['mobile-menu__link', { 'is-active': isActive(item, path) }]}
                aria-current={isActive(item, path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="mobile-menu__contact">
      <div class="mobile-menu__actions">
        <a class="btn btn--primary" href={site.phones.office.href}>
          <Icon name="phone" />
          Call us
        </a>
        <a class="btn btn--soft" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          <Icon name="message" />
          WhatsApp<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
      <p>
        <a href={`mailto:${site.emails.admin}`}>{site.emails.admin}</a>
      </p>
      <p>{site.hours.display}</p>
    </div>
  </div>
</dialog>

<style>
  .mobile-menu {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--white);
    color: var(--color-text);
    overscroll-behavior: contain;
  }

  .mobile-menu::backdrop {
    background: rgb(6 34 59 / 0.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in 220ms var(--ease-out);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: env(safe-area-inset-top) max(var(--gutter), env(safe-area-inset-right))
      max(1.5rem, env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu__brand img {
    width: auto;
    height: 2.75rem;
  }

  .mobile-menu__close {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--navy-800);
  }

  .mobile-menu__list {
    list-style: none;
    padding-block: 0.75rem;
  }

  .mobile-menu__list > li {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--color-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: left;
    text-decoration: none;
  }

  .mobile-menu__link.is-active {
    color: var(--navy-800);
  }

  :global(.mobile-menu__chevron) {
    color: var(--slate-500);
    transition: transform var(--duration) var(--ease-out);
  }

  [aria-expanded='true'] > :global(.mobile-menu__chevron) {
    transform: rotate(180deg);
  }

  .mobile-menu__sub {
    list-style: none;
    padding: 0 0 0.75rem;
  }

  .mobile-menu__sub a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
    color: var(--slate-700);
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-menu__sub a[aria-current='page'] {
    border-left-color: var(--navy-800);
    color: var(--navy-800);
    font-weight: 600;
  }

  .mobile-menu__sub .mobile-menu__overview {
    color: var(--navy-800);
    font-weight: 600;
  }

  .mobile-menu__contact {
    margin-top: auto;
    padding-top: 1.5rem;
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .mobile-menu__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .mobile-menu__contact a:not(.btn) {
    color: var(--navy-800);
    font-weight: 600;
  }
</style>
