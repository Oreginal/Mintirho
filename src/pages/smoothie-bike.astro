---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import FeatureImage from '../components/FeatureImage.astro';
import Icon from '../components/Icon.astro';
import VideoFeature from '../components/VideoFeature.astro';
import { media, smoothieVideo } from '../data/media';
import rider from '../assets/photos/smoothie-bike-rider.jpg';
import bikes from '../assets/photos/smoothie-bikes.jpg';
import { smoothieBike } from '../data/offerings';
import { site, whatsappUrl } from '../data/site';

const whatsapp = whatsappUrl(smoothieBike.whatsappMessage);
const instagram = site.socials.find((s) => s.label === 'Instagram') ?? site.socials[0];
---

<BaseLayout
  title="Smoothie Bike"
  description="The Mintirho Smoothie Bike lets you blend healthy drinks using your own pedal power. Book Pedal & Blend for events, parties and regular sessions."
  image={media.smoothieFeature.src}
>
  <section class="sb-hero">
    <div class="container">
      <Breadcrumbs crumbs={[{ name: 'Smoothie Bike', path: '/smoothie-bike' }]} />
      <div class="sb-hero__grid">
        <div class="sb-hero__copy">
          <p class="eyebrow eyebrow--wellness" data-hero-item>
            {smoothieBike.brand}
          </p>
          <h1 class="heading-display">The Mintirho Smoothie Bike</h1>
          <p class="lead" data-hero-item>
            {smoothieBike.invitation}
          </p>
          <p data-hero-item>{smoothieBike.intro}</p>
          <div class="btn-row" data-hero-item>
            <a class="btn btn--wellness" href="#enquire">
              Enquire about a booking
              <Icon name="arrow-right" class="icon-arrow" />
            </a>
            <a class="btn btn--soft" href={whatsapp} target="_blank" rel="noopener noreferrer">
              <Icon name="message" />
              WhatsApp us<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
        <FeatureImage
          image={media.smoothieHero}
          variant="overlay"
          aspect="10 / 9"
          position="60% 50%"
          widths={[480, 720, 960, 1376]}
          sizes="(min-width: 80em) 34rem, (min-width: 56em) 44vw, 100vw"
          priority
          overlay={{
            icon: 'bike',
            title: smoothieBike.brand,
            text: 'Fresh fruit, blended by pedal power',
            badge: 'Events and parties',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <SectionHeading
        eyebrow="How it works"
        tone="wellness"
        title="Three simple steps"
        lead="Create your perfect smoothie while getting a fun workout."
        id="how-heading"
      />
      <ol class="steps" role="list">
        {smoothieBike.steps.map((step, index) => (
          <li class="step" data-reveal>
            <span class="step__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="heading-sub">{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--bordered" aria-labelledby="video-heading">
    <div class="container">
      <SectionHeading
        eyebrow="In action"
        tone="wellness"
        title="See the Smoothie Bike in action"
        lead="Pedal, blend and enjoy. Follow us on Instagram for more from Mintirho."
        id="video-heading"
      />
      <VideoFeature
        poster={media.smoothieVideoPoster}
        video={smoothieVideo}
        instagramUrl={instagram.href}
        instagramHandle={instagram.handle}
      />
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="benefits-heading">
    <div class="container benefits">
      <div class="media-frame benefits__media" data-reveal>
        <Picture
          src={rider}
          formats={['avif', 'webp']}
          widths={[400, 600, 868]}
          sizes="(min-width: 64em) 28rem, (min-width: 40em) 70vw, 100vw"
          alt="A smiling rider pedals the blue Mintirho smoothie bike while a fruit smoothie blends at the front"
        />
      </div>
      <div>
        <SectionHeading
          eyebrow="Why it works"
          tone="wellness"
          title="Fitness, nutrition and fun in one experience"
          id="benefits-heading"
        />
        <dl class="benefits__list">
          {smoothieBike.benefits.map((benefit) => (
            <div data-reveal>
              <dt>{benefit.title}</dt>
              <dd>{benefit.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="occasions-heading">
    <div class="container occasions">
      <div class="occasions__copy">
        <SectionHeading
          eyebrow="Bookings"
          tone="wellness"
          title="For events, parties and regular sessions"
          lead={smoothieBike.closing}
          id="occasions-heading"
        />
        <ul class="checklist checklist--wellness" role="list" data-reveal>
          {smoothieBike.occasions.map((occasion) => (
            <li>{occasion}</li>
          ))}
        </ul>
        <p class="occasions__wellness" data-reveal>
          The Smoothie Bike is part of Mintirho's wellness work, alongside our{' '}
          <a href="/services/employee-wellness">employee wellness</a> services, which include
          wellness education and wellness events.
        </p>
      </div>
      <div class="media-frame occasions__media" data-reveal>
        <Picture
          src={bikes}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1312]}
          sizes="(min-width: 64em) 36rem, 100vw"
          alt="The blue and red Mintirho smoothie bikes, with watermelon and orange wheel covers"
          data-drift
        />
      </div>
    </div>
  </section>

  <section class="section section--muted" id="enquire" aria-labelledby="enquire-heading">
    <div class="container enquire">
      <div class="enquire__copy" data-reveal>
        <p class="eyebrow eyebrow--wellness">Enquire</p>
        <h2 id="enquire-heading" class="heading-section">
          Ready to pedal and blend?
        </h2>
        <p>
          Get in touch to book your smoothie bike experience. We offer flexible packages for events,
          parties and regular sessions. Tell us about your plans and we will share the options and
          pricing.
        </p>
        <div class="btn-row">
          <a class="btn btn--wellness" href={whatsapp} target="_blank" rel="noopener noreferrer">
            <Icon name="message" />
            WhatsApp enquiry<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          <a class="btn btn--ghost" href={site.phones.office.href}>
            <Icon name="phone" />
            {site.phones.office.display}
          </a>
        </div>
      </div>
      <EnquiryForm defaultTopic="smoothie-bike" heading="Send a booking enquiry" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .sb-hero {
    padding-block: clamp(1rem, 0.75rem + 1vw, 1.5rem) clamp(3rem, 2rem + 4vw, 5rem);
    border-bottom: 1px solid var(--navy-100);
    background: var(--gradient-brand-soft);
  }

  .sb-hero__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
    margin-top: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  @media (min-width: 56em) {
    .sb-hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .sb-hero__copy {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
  }

  .sb-hero__copy .btn-row {
    margin-top: 0.5rem;
  }

  /* Steps */
  .steps {
    list-style: none;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 48em) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .step {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 2px solid var(--emerald-700);
  }

  .step__number {
    color: var(--emerald-700);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .step p {
    color: var(--color-text-muted);
  }

  /* Benefits */
  .benefits {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 64em) {
    .benefits {
      grid-template-columns: 26rem minmax(0, 1fr);
      gap: 5rem;
      align-items: center;
    }
  }

  .benefits__media {
    aspect-ratio: 4 / 5;
    max-width: 30rem;
  }

  .benefits__media :global(img) {
    object-position: 50% 30%;
  }

  .benefits__list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 40em) {
    .benefits__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }

  .benefits__list > div {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .benefits__list dt {
    color: var(--color-heading);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .benefits__list dd {
    color: var(--color-text-muted);
  }

  /* Occasions */
  .occasions {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 64em) {
    .occasions {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 4rem;
      align-items: center;
    }
  }

  .occasions__copy {
    display: grid;
  }

  .occasions__copy :global(.section-heading) {
    margin-bottom: 1.75rem;
  }

  .occasions__wellness {
    margin-top: 1.75rem;
    color: var(--color-text-muted);
  }

  .occasions__wellness a {
    color: var(--emerald-700);
    font-weight: 600;
  }

  .occasions__media {
    aspect-ratio: 1312 / 835;
  }

  /* Enquire */
  .enquire {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 64em) {
    .enquire {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .enquire__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
</style>
