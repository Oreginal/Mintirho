---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import KeyFacts from '../components/KeyFacts.astro';
import CtaBand from '../components/CtaBand.astro';
import logo from '../assets/brand/mintirho-logo.png';
import { DotPattern } from '@/components/ui/dot-pattern';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// Source: the legacy about.html supplied by the client.
const mission = [
  'Our commitment is to provide a quality of service that is cost effective and reliable whilst remaining within the ethical and legal frameworks of the professional field within which we practice.',
  'We endeavour to thrive with integrity and to be responsive and reliable to the needs of our clients.',
];
const vision =
  'To be the most preferred cost effective and efficient occupational health services.';
const values = ['Excellence', 'Compliance', 'Quality of Service', 'Trustworthiness'];
---

<BaseLayout
  title="About us"
  description="Mintirho Healthcare and Consulting Services is a legal compliance medical surveillance company, registered in September 2014 and based in Alberton, Gauteng."
>
  <PageHero
    crumbs={[{ name: 'About', path: '/about' }]}
    eyebrow="About us"
    title="About Mintirho"
    lead={`A legal compliance medical surveillance company, registered in ${site.registered.display} and operating since ${site.operational.display}.`}
  />

  <section class="section" aria-labelledby="overview-heading">
    <div class="container about-intro">
      <div class="prose" data-reveal>
        <h2 id="overview-heading" class="heading-section">
          Overview
        </h2>
        <p>
          {site.legalName} is a legal compliance medical surveillance company, registered in{' '}
          {site.registered.display} and operating since {site.operational.display}. Mintirho
          appreciates the enormous task and challenges facing employers to ensure sound governance
          and compliance to legislation.
        </p>
        <p>
          We are confident that we add value by providing medical expertise and occupational medical
          information useful to management in responding to, and being decisive about, workplace
          health related issues such as sick absenteeism, disability and incapacity due to ill
          health.
        </p>
        <p>
          Our services aim to support the employer in meeting legal requirements and ensure that
          employees receive a comprehensive medical screening programme in compliance with the
          Occupational Health and Safety Act No 85, 1993, the Mines Health and Safety Act No 29,
          1996, and the Employment Equity Act.
        </p>
      </div>
      <figure class="brand-panel" data-reveal>
        <DotPattern
          width={18}
          height={18}
          cr={1.1}
          className="fill-sky-800/25 [mask-image:radial-gradient(ellipse_at_center,transparent_30%,white_80%)]"
        />
        <div class="brand-panel__plate">
          <Image
            src={logo}
            alt={site.name}
            width={300}
            height={126}
            densities={[1, 1.25]}
            format="webp"
            quality={90}
            class="brand-panel__logo"
          />
        </div>
        <figcaption class="brand-panel__caption">
          <span class="brand-panel__kicker">Established 2014</span>
          <span class="brand-panel__title">
            Occupational health, compliance and workplace wellness
          </span>
          <span class="brand-panel__meta">
            <Icon name="pin" size={16} />
            <span>Alberton, Gauteng</span>
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="facts-heading">
    <div class="container facts-layout">
      <SectionHeading eyebrow="At a glance" title="Key facts" id="facts-heading" />
      <div data-reveal>
        <KeyFacts />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="purpose-heading">
    <div class="container">
      <SectionHeading eyebrow="Our purpose" title="Mission and vision" id="purpose-heading" />
      <div class="purpose">
        <div class="purpose__item" data-reveal>
          <h3 class="heading-sub">Mission</h3>
          <ul class="checklist" role="list">
            {mission.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
        <div class="purpose__item" data-reveal>
          <h3 class="heading-sub">Vision</h3>
          <p class="purpose__vision">{vision}</p>
        </div>
      </div>

      <div class="values" data-reveal>
        <h3 class="heading-sub">Our values</h3>
        <ol role="list" class="values__list">
          {values.map((value, index) => (
            <li>
              <span class="values__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              {value}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {site.clients.length > 0 && (
    <section class="section section--muted" aria-labelledby="clients-heading">
      <div class="container">
        <SectionHeading eyebrow="Clients" title="Organisations we work with" id="clients-heading" />
        <ul class="clients" role="list">
          {site.clients.map((client) => (
            <li>{client.name}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  .about-intro {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 64em) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr) 26rem;
      gap: 5rem;
      align-items: start;
    }
  }

  /* Brand panel (the owner asked for the logo instead of her photo). */
  .brand-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    max-width: 30rem;
    margin: 0;
    padding: clamp(2rem, 1.5rem + 2vw, 3rem) 2rem;
    border: 1px solid var(--navy-100);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(420px 320px at 50% 38%, var(--white), transparent 70%),
      var(--gradient-brand-soft);
    box-shadow: var(--shadow-photo);
  }

  @media (min-width: 64em) {
    .brand-panel {
      aspect-ratio: 4 / 5;
    }
  }

  /* White plate keeps the logo clear of the dot pattern behind it. */
  .brand-panel__plate {
    position: relative;
    z-index: 1;
    padding: 1.5rem 2rem;
    border: 1px solid var(--navy-100);
    border-radius: 1.25rem;
    background: var(--white);
    box-shadow: var(--shadow-3);
  }

  .brand-panel :global(.brand-panel__logo) {
    display: block;
    width: min(15rem, 60vw);
    height: auto;
  }

  .brand-panel__caption {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    text-align: center;
  }

  .brand-panel__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ruby-600);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .brand-panel__kicker::before,
  .brand-panel__kicker::after {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .brand-panel__title {
    max-width: 19rem;
    color: var(--navy-950);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .brand-panel__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--slate-600);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .brand-panel__meta :global(svg) {
    color: var(--ruby-600);
  }

  .facts-layout {
    display: grid;
  }

  @media (min-width: 64em) {
    .facts-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
      gap: 4rem;
    }
  }

  .purpose {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48em) {
    .purpose {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .purpose__item {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 2px solid var(--navy-800);
  }

  .purpose__vision {
    color: var(--color-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.5;
  }

  .values {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .values__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 48em) {
    .values__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .values__list li {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 1rem 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-heading);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .values__number {
    color: var(--ruby-600);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .clients {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    font-weight: 600;
  }
</style>
