---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  tone?: 'accent' | 'wellness' | 'muted';
  id?: string;
  level?: 2 | 3;
}

const { eyebrow, title, lead, align = 'start', tone = 'accent', id, level = 2 } = Astro.props;
const Tag = level === 3 ? 'h3' : 'h2';
---

<div class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  {eyebrow && (
    <p
      class:list={[
        'eyebrow',
        { 'eyebrow--wellness': tone === 'wellness', 'eyebrow--muted': tone === 'muted' },
      ]}
    >
      {eyebrow}
    </p>
  )}
  <Tag id={id} class="heading-section">
    {title}
  </Tag>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

<style>
  .section-heading {
    display: grid;
    gap: 0.875rem;
    max-width: 44rem;
    margin-bottom: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
  }

  .section-heading--center {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }
</style>
