---
import Icon from './Icon.astro';
import { serviceHref, type Service } from '../data/services';

interface Props {
  services: Service[];
  headingLevel?: 2 | 3;
}

const { services, headingLevel = 3 } = Astro.props;
const Tag = headingLevel === 2 ? 'h2' : 'h3';
---

<ul class="service-list" role="list">
  {services.map((service) => (
    <li class="service-row" data-reveal>
      <Tag class="service-row__title">
        <a href={serviceHref(service)}>{service.title}</a>
      </Tag>
      <p class="service-row__summary">{service.summary}</p>
      <Icon name="arrow-right" class="service-row__arrow icon-arrow" />
    </li>
  ))}
</ul>

<style>
  .service-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 48em) {
    .service-row {
      grid-template-columns: minmax(12rem, 18rem) 1fr auto;
      align-items: baseline;
      padding-block: 1.75rem;
    }
  }

  .service-row__title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .service-row__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link over the whole row for a generous target. */
  .service-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-row__title a:focus-visible {
    outline: none;
  }

  .service-row:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .service-row__summary {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
  }

  :global(.service-row__arrow) {
    grid-row: 1;
    grid-column: 2;
    align-self: center;
    color: var(--navy-800);
  }

  @media (min-width: 48em) {
    .service-row__summary {
      grid-column: 2;
    }

    :global(.service-row__arrow) {
      grid-column: 3;
    }
  }

  @media (hover: hover) {
    .service-row:hover .service-row__title {
      color: var(--navy-800);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .service-row:hover :global(.service-row__arrow) {
      transform: translateX(3px);
    }
  }
</style>
