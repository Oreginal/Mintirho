---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { reviews, testimonials } from '../data/site';

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section class="section section--tint" aria-labelledby="testimonials-heading">
  <div class="container">
    <SectionHeading
      eyebrow="Client feedback"
      title="What our clients say"
      align="center"
      id="testimonials-heading"
    />
    <div class="quotes">
      {testimonials.map((testimonial) => (
        <figure class="quote" data-reveal>
          <span class="quote__rating" role="img" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <Icon name="star" size={16} class="quote__star" />
            ))}
          </span>
          <span class="quote__mark" aria-hidden="true">
            &ldquo;
          </span>
          <blockquote>
            <p>{testimonial.quote}</p>
          </blockquote>
          <figcaption>
            <span class="quote__avatar" aria-hidden="true">
              {initials(testimonial.name)}
            </span>
            <span class="quote__meta">
              <span class="quote__name">{testimonial.name}</span>
              <span class="quote__source">{testimonial.source}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="quotes__more">
      <a class="link-arrow" href={reviews.url} target="_blank" rel="noopener noreferrer">
        <span>Read our reviews on Google</span>
        <Icon name="external" size={16} />
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </p>
  </div>
</section>

<style>
  .quotes {
    display: grid;
    gap: 1.25rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 48em) {
    .quotes {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 64em) {
    .quotes {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: var(--shadow-1);
  }

  .quote__rating {
    display: flex;
    gap: 0.125rem;
  }

  .quote__rating :global(.quote__star) {
    color: #f5a623;
    fill: currentColor;
    stroke: none;
  }

  .quote__mark {
    height: 1.75rem;
    color: var(--ruby-600);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 3.5rem;
    line-height: 1;
  }

  .quote blockquote p {
    color: var(--color-heading);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .quote__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--navy-50);
    color: var(--navy-800);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .quote__meta {
    display: grid;
    line-height: 1.35;
  }

  .quote__name {
    color: var(--color-heading);
    font-weight: 600;
  }

  .quote__source {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .quotes__more {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
